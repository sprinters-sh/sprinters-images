ARG RUNNER_IMAGE_VERSION=20260907.300
# ARM64 launchers and CI pass this pin as RUNNER_IMAGE_VERSION.
ARG RUNNER_IMAGE_VERSION_ARM64=20260907.118
ARG RUNNER_VERSION=2.337.0
ARG MINIMAL=false
ARG SLIM=false

FROM ubuntu:24.04 AS base

ARG RUNNER_IMAGE_VERSION
ARG MINIMAL
ARG SLIM
ENV RUNNER_IMAGE_VERSION=$RUNNER_IMAGE_VERSION MINIMAL=$MINIMAL SLIM=$SLIM

RUN --mount=source=ubuntu-24.04/setup-as-root.sh,target=/setup-as-root.sh /setup-as-root.sh

USER runner
WORKDIR /tmp

# The build is split into stages that BuildKit runs in parallel. Everything that changes shared state, like packages,
# is installed one after another in "prepared", "system-1", "java" and "system-2". Self-contained tools are installed
# in isolation in their own stages, and merged into the image in "build".
FROM base AS prepared
RUN --mount=source=build,target=/build /build/prepare.sh

FROM prepared AS system-1
RUN --mount=source=build,target=/build /build/system-1.sh

FROM system-1 AS java
RUN --mount=source=build,target=/build /build/java.sh

FROM java AS system-2
RUN --mount=source=build,target=/build /build/system-2.sh

FROM prepared AS codeql
RUN --mount=source=build,target=/build /build/tool.sh codeql

FROM prepared AS julia
RUN --mount=source=build,target=/build /build/tool.sh julia

FROM prepared AS miniconda
RUN --mount=source=build,target=/build /build/tool.sh miniconda

FROM prepared AS packer
RUN --mount=source=build,target=/build /build/tool.sh packer

FROM prepared AS pulumi
RUN --mount=source=build,target=/build /build/tool.sh pulumi

FROM prepared AS pypy
RUN --mount=source=build,target=/build /build/tool.sh pypy

# Swift needs libraries that packages installed by "system-1" depend on
FROM system-1 AS swift
RUN --mount=source=build,target=/build /build/tool.sh swift

FROM prepared AS yq
RUN --mount=source=build,target=/build /build/tool.sh yq

# Ninja needs cmake
FROM system-1 AS ninja
RUN --mount=source=build,target=/build /build/tool.sh ninja

FROM java AS kotlin
RUN --mount=source=build,target=/build /build/tool.sh kotlin

FROM java AS selenium
RUN --mount=source=build,target=/build /build/tool.sh selenium

FROM java AS android
RUN --mount=source=build,target=/build --mount=from=yq,target=/leaves/yq /build/merge.sh
RUN --mount=source=build,target=/build /build/tool.sh android

FROM system-2 AS build
RUN --mount=source=build,target=/build \
    --mount=from=codeql,target=/leaves/codeql \
    --mount=from=julia,target=/leaves/julia \
    --mount=from=miniconda,target=/leaves/miniconda \
    --mount=from=packer,target=/leaves/packer \
    --mount=from=pulumi,target=/leaves/pulumi \
    --mount=from=pypy,target=/leaves/pypy \
    --mount=from=swift,target=/leaves/swift \
    --mount=from=yq,target=/leaves/yq \
    --mount=from=ninja,target=/leaves/ninja \
    --mount=from=kotlin,target=/leaves/kotlin \
    --mount=from=selenium,target=/leaves/selenium \
    --mount=from=android,target=/leaves/android \
    /build/merge.sh
RUN --mount=source=build,target=/build /build/toolcache.sh
RUN --mount=source=build,target=/build /build/finalize.sh

ARG RUNNER_VERSION
RUN --mount=source=common/setup-agent.sh,target=/setup-agent.sh /setup-agent.sh
RUN --mount=source=common/setup-runner.sh,target=/setup-runner.sh /setup-runner.sh $RUNNER_VERSION

COPY --chmod=555 common/entrypoint.sh /entrypoint.sh
COPY --chmod=555 common/start-docker.sh /start-docker.sh
COPY --chmod=555 common/start-agent.sh /start-agent.sh
COPY --chmod=555 common/job-started.sh /job-started.sh
COPY --chmod=555 common/job-completed.sh /job-completed.sh
COPY --chmod=555 common/publish-event.sh /publish-event.sh

FROM scratch AS image

ARG RUNNER_IMAGE_VERSION
ARG RUNNER_VERSION

ENV DEBIAN_FRONTEND=noninteractive
ENV RUNNER_MANUALLY_TRAP_SIG=1
ENV ACTIONS_RUNNER_PRINT_LOG_TO_STDOUT=1
ENV ImageOS=ubuntu24
ENV ACTIONS_RUNNER_HOOK_JOB_STARTED=/job-started.sh
ENV ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/job-completed.sh

LABEL org.opencontainers.image.source=https://github.com/sprinters-sh/sprinters-images
LABEL org.opencontainers.image.description="Sprinters GitHub Actions runner"
LABEL org.opencontainers.image.licenses=MIT
LABEL sh.sprinters.runner-image.version=$RUNNER_IMAGE_VERSION
LABEL sh.sprinters.runner.version=$RUNNER_VERSION

COPY --from=build / /

USER runner
WORKDIR /home/runner
ENV HOME=/home/runner

# Quick sanity check ensuring the runner is fully functional
RUN ./config.sh --version

CMD ["/entrypoint.sh"]
